{
    "makefile.configureOnOpen": false,

    "tinymist.formatterIndentSize": 4,
    "tinymist.formatterProseWrap": true,
    "tinymist.formatterPrintWidth": 120,
    "tinymist.preview.refresh": "onSave",
    "tinymist.formatterMode": "typstyle",
    "tinymist.completion.symbol": "stepless",
    "tinymist.fontPaths": ["./fonts"],
    "tinymist.typstExtraArgs": ["--input", "git-hash=VSCode预览模式"],

    "[typst]": {
        "editor.defaultFormatter": "myriad-dreamin.tinymist"
    }
}
